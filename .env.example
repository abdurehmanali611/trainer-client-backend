# Standalone trainer-client backend configuration (copy to .env and fill in)

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL (same database as the trainer backend; SSL is enabled automatically
# for non-local hosts like Aiven). Leave DB_NAME empty to fall back to sqlite.
DB_NAME=trainer_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_SSL=true
# DB_CONN_MAX_AGE=60

# Alternatively use a single URL (used only when DB_NAME is empty)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# CORS — origin of the client app web dev server (allow-all defaults to DEBUG)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# CORS_ALLOW_ALL_ORIGINS=true

# Run this backend with: python manage.py runserver 8001

# Must match trainer/BackEnd/.env JWT_SECRET (client JWTs are signed with it)
JWT_SECRET=change-me-to-a-long-random-secret

# Deep-link base used in reset emails
# CLIENT_APP_RESET_URL=trainerclient://auth/reset
